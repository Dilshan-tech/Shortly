# ==============================================================================
# Shortly Backend Environment Configuration Example
# Copy this file to backend/.env and adjust values for your environment.
# ==============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# Public URL used to generate short links and QR codes:
# - Local: http://localhost:5000
# - Wi-Fi LAN: http://<laptop-ip>:5000
# - VS Code Port Forwarding: https://<hash>-5000.app.github.dev
# - Production: https://s.yourdomain.com
PUBLIC_URL=http://localhost:5000

# Frontend origin for CORS and redirects:
# - Local: http://localhost:5173
# - Wi-Fi LAN: http://<laptop-ip>:5173
# - VS Code Port Forwarding: https://<hash>-5173.app.github.dev
# - Production: https://app.yourdomain.com
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Allow local destination URLs during development
ALLOW_LOCAL_URLS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
REDIRECT_RATE_LIMIT_MAX=300

# Short code generator length
SHORT_CODE_LENGTH=7
