# ==============================================================================
# Shortly Frontend Environment Configuration Example
# Copy this file to frontend/.env and adjust values for your environment.
# ==============================================================================

# Backend API Base URL
# - Local/LAN: Leave empty to use Vite's built-in /api proxy
# - VS Code Port Forwarding: https://<hash>-5000.app.github.dev
# - Production: https://api.yourdomain.com
VITE_API_BASE_URL=

# Vite Dev Proxy Target (where Vite forwards /api calls in development)
VITE_BACKEND_URL=http://localhost:5000

# Configured public URL base for short links
VITE_PUBLIC_URL=http://localhost:5000

# Vite Dev Server Host & Port
# 0.0.0.0 exposes the dev server to devices on the same Wi-Fi network
VITE_HOST=0.0.0.0
VITE_PORT=5173
