# ==============================================================================
# Shortly Full-Stack Environment Configuration Template
# ==============================================================================
#
# THREE SUPPORTED ENVIRONMENTS:
#
# ------------------------------------------------------------------------------
# 1. LOCAL LAPTOP DEVELOPMENT:
#    PUBLIC_URL=http://localhost:5000
#    FRONTEND_URL=http://localhost:5173
#
# ------------------------------------------------------------------------------
# 2. VS CODE PORT FORWARDING (Mobile Phone over Forwarded Tunnel):
#    - Forward port 5173 (Frontend) and port 5000 (Backend) in VS Code Ports tab.
#    - Set Port 5000 Visibility to "Public".
#    - Copy the Port 5000 forwarded URL (e.g. https://<id>-5000.app.github.dev).
#    - Configure:
#      PUBLIC_URL=https://<your-id>-5000.app.github.dev
#      FRONTEND_URL=https://<your-id>-5173.app.github.dev
#
# ------------------------------------------------------------------------------
# 3. PRODUCTION DEPLOYMENT (Strict HTTPS & Domain):
#    NODE_ENV=production
#    PUBLIC_URL=https://sho.rt
#    FRONTEND_URL=https://sho.rt
#    ALLOW_LOCAL_URLS=false
# ==============================================================================

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Backend Public URL used for short links & QR codes (Port 5000 target)
PUBLIC_URL=http://localhost:5000

# Frontend URL used for CORS and dashboard redirects (Port 5173 target)
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shortly?retryWrites=true&w=majority

# Optional: Extra comma-separated allowed CORS origins
# ALLOWED_ORIGINS=https://app.sho.rt,https://sho.rt

# Security: Allow local destination URLs in development
ALLOW_LOCAL_URLS=true
SHORT_CODE_LENGTH=7
