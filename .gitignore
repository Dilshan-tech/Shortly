gitignore
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/
*/node_modules/

# Production build outputs
dist/
build/
frontend/dist/

# Local Environment Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Storage data
backend/data/*.json
!backend/data/.gitkeep
backend/data-test/*.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?